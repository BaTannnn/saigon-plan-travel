<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="SaigonPlanTravel E2E Suite">
    <listeners>
        <listener class-name="com.saigonplantravel.e2e.listeners.TestListener"/>
    </listeners>
    <test name="Smoke Tests">
        <groups>
            <run>
                <include name="smoke"/>
            </run>
        </groups>
    </test>
    
    <test name="Authentication">
        <classes>
            <class name="com.saigonplantravel.e2e.test.LoginTest"/>
        </classes>
    </test>
</suite>